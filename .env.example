# BlackoutTracker · el ÚNICO .env del proyecto (D-030). Lo leen la API (`pnpm dev`), los scripts
# `pnpm db:*`, la web (`pnpm dev`, solo las VITE_*) y Docker (`pnpm app:up`).
# Nunca se sube al repo (.gitignore). Guía completa: docs/despliegue.md.
# Llena solo lo marcado con <…>; lo demás ya tiene su valor por defecto.

# ─── Supabase · Project Settings → Data API / API Keys ──────────────────────────────────────
# Project URL, sin barra al final. Va dos veces: la API la usa para el JWKS y la web para Auth.
SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_URL=https://<ref>.supabase.co
# Publishable key (sb_publishable_…) o la anon heredada. Es pública. NUNCA la service_role.
VITE_SUPABASE_ANON_KEY=<publishable-key>

# ─── Base de datos · Connect → Session pooler (puerto 5432) ─────────────────────────────────
# SECRETO. La misma base que lee la web por Realtime. Símbolos de la clave codificados para URL
# (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Los tests de integración usan SIEMPRE la base local de Docker (pnpm db:up). No lo cambies.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/blackout_test

# ─── API (valores por defecto: no hace falta tocarlos) ──────────────────────────────────────
JWT_AUDIENCE=authenticated
# 5173 = web con pnpm dev · 8080 = web en Docker. En Render: la URL de Vercel.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# 0 en local; Docker lo pone en 1 solo (va detrás de nginx); 1 en Render.
TRUST_PROXY=0
PORT=3000
CRON_ACTIVO=true

# Consenso: N vecinos distintos dentro de una ventana (minutos) por servicio.
CONSENSO_N=3
CONSENSO_VENTANA_MIN_ELECTRICIDAD=30
CONSENSO_VENTANA_MIN_AGUA=180
# Estimación: mínimo de cortes cerrados para dar una cifra.
ESTIMACION_N_MIN=5
# Límites de la hora de un reporte.
REPORTE_MAX_ANTIGUEDAD_DIAS=7
REPORTE_VENCE_HORAS=48

# ─── Notificaciones push (T-072, D-042) ─────────────────────────────────────────────────────
# Sin claves VAPID la API no envía nada y la web no las ofrece. Se generan con
# `npx web-push generate-vapid-keys`; van las dos o ninguna. La privada es SECRETA.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:<tu correo>
# URL pública de la API, sin /api: la imagen del hexágono en la notificación.
# API_URL_PUBLICA=http://localhost:3000
# Horas de Caracas de los recordatorios (una por franja; el tope diario es cuántas hay).
RECORDATORIOS_HORAS=19
# Horas silenciosas: de las 22:00 a las 07:00 no suena nada (salvo el agua de noche).
SILENCIO_DESDE=22
SILENCIO_HASTA=7

# ─── Web (opcional) ─────────────────────────────────────────────────────────────────────────
# Solo si la API está en otro dominio. En local, Vite y el nginx de Docker reenvían /api solos.
# VITE_API_URL=https://<servicio>.onrender.com/api
