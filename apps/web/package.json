{
  "name": "@blackout/web",
  "version": "0.0.0",
  "private": true,
  "description": "PWA de BlackoutTracker: mapa de sectores, reportes y cola sin conexión.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
