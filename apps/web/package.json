    "@turf/center-of-mass": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "dexie": "^4.4.7",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
