# Copia este archivo a `.env.local` (nunca se sube al repo). Sin estas variables, abre la app con
# `/?demo=en-linea` o `/?demo=sin-conexion` para usar los datos de ejemplo.

# API de Nest. En desarrollo, Vite reenvía `/api` a http://localhost:3000, así que no hace falta.
# VITE_API_URL=https://<servicio>.onrender.com/api

# Supabase: solo para Auth y Realtime. La clave es la pública (publishable / anon), nunca la de servicio.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-publica>
