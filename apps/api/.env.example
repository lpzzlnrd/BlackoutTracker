# Copia este archivo a `.env` (nunca se sube al repo). Valores por defecto en docs/PLAN.md §7.

# Base local (pnpm db:up). Los tests de integración usan `blackout_test` (ver DATABASE_URL_TEST).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/blackout
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/blackout_test

# Origen de Supabase: de aquí salen el JWKS y el issuer del guard JWT (T-013).
SUPABASE_URL=https://<ref>.supabase.co
JWT_AUDIENCE=authenticated

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Proxies de confianza delante de la API (1 en Render; 0 en local).
TRUST_PROXY=0

# Consenso (N usuarios distintos y ventana por servicio, en minutos) y estimación (n mínimo).
CONSENSO_N=3
CONSENSO_VENTANA_MIN_ELECTRICIDAD=30
CONSENSO_VENTANA_MIN_AGUA=180
ESTIMACION_N_MIN=5

# Límites de la hora de un reporte.
REPORTE_MAX_ANTIGUEDAD_DIAS=7
REPORTE_VENCE_HORAS=48

# Cron de las ventanas de consenso (cada minuto). false lo apaga.
CRON_ACTIVO=true

PORT=3000
