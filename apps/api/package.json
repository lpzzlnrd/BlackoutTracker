{
  "name": "@blackout/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST de BlackoutTracker (NestJS 11).",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm --filter @blackout/shared build && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:int": "jest --config test/jest-e2e.config.ts --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only scripts/migrar.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node --transpile-only scripts/seed-sectores.ts",
    "red:intermitente": "ts-node --transpile-only scripts/red-intermitente/index.ts",
    "db:seed:campo": "ts-node --transpile-only scripts/seed-campo.ts"
  },
  "dependencies": {
    "@blackout/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
