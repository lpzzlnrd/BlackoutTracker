{
  "name": "@blackout/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos, enums y constantes comunes de la API y del frontend. Sin dependencias de runtime.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsup && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "catalog:"
  }
}
